# Credenciais de deploy. Copie este arquivo para .deploy.env e preencha com os
# valores reais. O .deploy.env NÃO é versionado.

# --- VPS Docker antigo (update.py) — NÃO atualiza o site live de frontend ---
CSP_VPS_HOST=2.24.115.74
CSP_VPS_USER=root
# Chave SSH (o VPS aceita so publickey). Se omitido, usa ~/.ssh/pdi_vps_ed25519 quando existir.
CSP_VPS_KEY=~/.ssh/pdi_vps_ed25519
# Alternativa por senha (so vale se o VPS voltar a aceitar):
# CSP_VPS_PASS=

# --- Hostinger (deploy_hostinger.py) — ONDE O SITE REALMENTE ESTÁ ---
# O frontend (servicedeskcsp.com.br) é hospedagem Hostinger (LiteSpeed/hPanel),
# publicado via API (upload TUS + deploy). Gere o token em developers.hostinger.com.
HOSTINGER_API_TOKEN=coloque-o-token-da-api-do-hostinger-aqui
HOSTINGER_DOMAIN=servicedeskcsp.com.br

# Client ID (tipo Web) do login com Google; publico, vai embutido no site. Sem ele o build e recusado.
VITE_GOOGLE_CLIENT_ID=
# URL absoluta do backend (o .htaccess da Hostinger nao encaminha /api)
VITE_API_URL=https://api.servicedeskcsp.com.br/api
